# ==============================================================================
# PashuMandi Backend Environment Configuration Template
# Copy this file to '.env' (which is git-ignored) and populate with your environment values.
# NEVER commit the actual '.env' or real credentials into version control!
# ==============================================================================

# Active Spring Profile (e.g., dev, uat, prod)
# SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 1. Development Database Configuration (Profile: dev)
# ------------------------------------------------------------------------------
DEV_DB_URL=jdbc:mysql://localhost:3306/pashumandi?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=your_local_dev_mysql_password

# ------------------------------------------------------------------------------
# 2. UAT Database Configuration (Profile: uat)
# ------------------------------------------------------------------------------
UAT_DB_URL=jdbc:mysql://uat-db-host:3306/pashumandi_uat?useSSL=true&serverTimezone=UTC
UAT_DB_USERNAME=pashumandi_uat_user
UAT_DB_PASSWORD=your_uat_secure_password

# ------------------------------------------------------------------------------
# 3. Production Database Configuration (Profile: prod)
# ------------------------------------------------------------------------------
PROD_DB_URL=jdbc:mysql://prod-db-host:3306/pashumandi_prod?useSSL=true&serverTimezone=UTC
PROD_DB_USERNAME=pashumandi_prod_user
PROD_DB_PASSWORD=your_prod_highly_secure_password

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Secrets
# Secret MUST be 256-bit (32+ bytes Base64-encoded or high-entropy secret)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_with_at_least_256_bits_length_here_example_key
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# 5. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Cloudinary Image Storage Configuration
# Set your Cloudinary cloud credentials below.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=xtg7v6vt
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_rotated_api_secret
