# ==============================================================================
# PashuMandi Backend Environment Configuration Template
# Copy this file to '.env' (which is git-ignored) and populate with your local values.
# NEVER commit the actual '.env' or real credentials into version control!
# ==============================================================================

# Database Connection (MySQL)
DB_URL=jdbc:mysql://localhost:3306/pashumandi?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# JWT Cryptographic Configuration (Secret must be 256-bit / 32+ characters Base64 encoded or high-entropy string)
JWT_SECRET=your_super_secret_jwt_key_with_at_least_256_bits_length_here_example_key
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Frontend Allowed Origin(s)
FRONTEND_URL=http://localhost:5173
