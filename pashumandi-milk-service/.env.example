# PashuMandi Milk Marketplace Microservice - Environment Configuration
# Copy this file to .env and adjust properties for your environment

# Server Configuration
SERVER_PORT=8081

# Milk Service Database Configuration (Separate schema from PashuMandi Auth/Animal service)
MILK_DB_URL=jdbc:mysql://localhost:3306/pashumandi_milk?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=your_mysql_password

# JWT Shared Secret - MUST MATCH PASHUMANDI AUTH SERVICE
# Minimum 256 bits (32 bytes) Base64 encoded or string
JWT_SECRET=dGVzdF9zZWNyZXRfa2V5X2Zvcl9wYXNodW1hbmRpX2F1dGhlbnRpY2F0aW9uX3N5c3RlbV8yNTZiaXRzIQ==
JWT_ACCESS_EXPIRATION=900000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
